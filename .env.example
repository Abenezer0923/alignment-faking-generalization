# Copy to .env and fill in only the providers you use.

# OpenRouter (paid, cheap): Llama 3.1 70B / 405B, Qwen
OPENROUTER_API_KEY=

# Groq (free tier): gpt-oss-120b
GROQ_API_KEY=

# Cloudflare Workers AI (free daily quota): Llama 70B
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google AI Studio (free tier): Gemini Flash, Gemma. Key from aistudio.google.com/apikey
GEMINI_API_KEY=
